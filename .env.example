# Copy this file to .env and replace the placeholder values.
# .env is ignored by Git and must never be committed.

# PostgreSQL
POSTGRES_DB=allocata
POSTGRES_USER=allocata
POSTGRES_PASSWORD=change_me

# RabbitMQ
RABBITMQ_DEFAULT_USER=allocata
RABBITMQ_DEFAULT_PASS=change_me

# Database (the app connects through PgBouncer, not directly to Postgres)
DB_HOST=localhost
DB_PORT=6432
# Flyway migrations connect directly to Postgres, bypassing PgBouncer
DB_DIRECT_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ connection (the app reuses RABBITMQ_DEFAULT_USER and RABBITMQ_DEFAULT_PASS above)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# App
SERVER_PORT=8080
