# Store text files with LF line endings in the repository and check them
# out as LF too, so config and scripts mounted into Linux containers work
# the same on every machine.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jar binary
